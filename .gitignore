# Node modules — both directory AND symlink patterns
# (no-slash covers symlinks, slash covers directories)
node_modules
node_modules/
.next/
out/
db/*.db
db/*.db-journal

# Environment files — never commit secrets
.env
.env.local
.env.production
.env.*.local

# Build artifacts
*.tar.gz
*.zip
tsconfig.tsbuildinfo
coverage/

# Logs
*.log

# PID files — runtime values, never commit
*.pid

# Tooling
tool-results/
upload/
download/
skills/
mini-services/
examples/
.zcode/
.zscripts/*.pid

# OS files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Backups — local pg_dump / JSON artifacts, never commit (SA-3)
/backups/

# MCP local configs — may contain tokens, never commit (.mcp.json is the committed template, env-only)
.mcp-aiven.json
mcp-aiven-config.json
.mcp.json.local
claude_desktop_config.json
