  interestCount    Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
  @@index([userId])
  @@index([acceptedBy])
  @@index([gameName])
}

  // ===== سجل النشاطات (Audit Log) =====
model AuditLog {
