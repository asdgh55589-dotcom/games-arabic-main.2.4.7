  week         Int
  day          Int // 0-4 (Sat=0 ... Wed=4), -1=rest day
  checked      Int
  broken       Int
  modsAffected Int
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  status       String    @default("completed") // completed | failed | skipped | in_progress
  createdAt    DateTime  @default(now())

  @@index([platform, week])
  @@index([createdAt])
}

// ===== Session ledger — reused for Supabase session management (Account/Verification removed) =====
model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}
