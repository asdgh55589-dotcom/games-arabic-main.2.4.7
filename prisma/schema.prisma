// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                  @id @default(cuid())
  supabaseId             String?                 @unique // Supabase Auth user ID
  username               String                  @unique
  email                  String                  @unique
  password               String? // hashed — null للمستخدمين العاديين (OAuth لاحقاً)
  avatarUrl              String?
  bannerUrl              String? // صورة الخلفية بمقاس اليوتيوب (2560×1440)
  bio                    String?
  websiteUrl             String? // الموقع الشخصي
  twitterUrl             String? // رابط Twitter/X
  githubUrl              String? // رابط GitHub
  discordUrl             String? // رابط Discord
  accentColor            String?                 @default("#ff8c00") // اللون المميز للملف الشخصي
  role                   String                  @default("member") // member | moderator | admin | owner
  bannedUntil            DateTime? // null = غير محظور
  banStatus              String                  @default("active") // active | banned_temp | banned_perm | restricted
  banReason              String? // سبب الحظر الحالي
  bannedBy               String? // id الأدمن الذي أصدر الحظر
  bannedAt               DateTime? // متى تم الحظر
  tokenVersion           Int                     @default(0) // لإبطال الجلسات القديمة عند الحظر/تغيير الدور
  tier                   Int                     @default(0) // 0=مبتدئ, 1=مترجم, 2=محترف, 3=خبير, 4=مشرف, 5=مدير
  specialRoles           String                  @default("") // CSV: "official_translator,reviewer,team"
  qualityScore           Float                   @default(0) // محسوب تلقائي
  lastTierUpgradeAt      DateTime?
  tierUpgradeCount       Int                     @default(0)
  lastLoginAt            DateTime?
  loginCount             Int                     @default(0)
  emailVerified          Boolean                 @default(false)
  joinedAt               DateTime                @default(now())
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  mods                   Mod[]                   @relation("AuthoredMods")
  endorsements           Endorsement[]
  comments               ModComment[]
  actionsAsTarget        UserAction[]            @relation("UserActionsTarget")
  actionsAsActor         UserAction[]            @relation("UserActionsActor")
  teamMemberships        TeamMembership[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  tierHistory            TierHistory[]
}

model Game {
  id                String     @id @default(cuid())
  slug              String     @unique
  name              String
  tagline           String
  description       String
  bannerUrl         String
  logoUrl           String?
  thumbnailUrl      String
  category          String // RPG | FPS | Strategy | Sandbox | Adventure | Simulation
  platform          String // PC | NS | PS1 | PS2 | PS3 | PS4
  releaseYear       Int
  modCount          Int        @default(0)
  totalDownloads    Int        @default(0)
  totalEndorsements Int        @default(0)
  featured          Boolean    @default(false)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  mods              Mod[]
  categories        Category[]
}

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameId    String
  mods      Mod[]
  createdAt DateTime @default(now())

  @@unique([gameId, slug])
}

model Mod {
  id                 String           @id @default(cuid())
  slug               String           @unique
  name               String
  summary            String
  description        String
  changelog          String           @default("") // سجل التغييرات (markdown)
  installGuide       String           @default("") // دليل التركيب (markdown)
  arabicTitle        String           @default("") // الاسم بالعربي
  compatibility      String           @default("") // التوافق
  authorId           String
  author             User             @relation("AuthoredMods", fields: [authorId], references: [id])
  gameId             String
  game               Game             @relation(fields: [gameId], references: [id], onDelete: Cascade)
  categoryId         String?
  category           Category?        @relation(fields: [categoryId], references: [id])
  thumbnailUrl       String
  imageUrl           String
  galleryUrls        String // comma-separated
  version            String
  fileSize           String
  fileFormat         String // 7z | zip | rar
  downloads          Int              @default(0)
  endorsements       Int              @default(0)
  views              Int              @default(0)
  comments           Int              @default(0)
  rating             Float            @default(0)
  ratingCount        Int              @default(0)
  tags               String // comma-separated
  series             String           @default("") // اسم السلسلة (مثل God of War) — للتوافق العكسي
  seriesId           String? // ربط بالسلسلة الجديدة
  translationTeam    String           @default("") // فريق التعريب أو المترجم المستقل — للتوافق العكسي
  teamId             String? // ربط بالفريق الجديد
  isFeatured         Boolean          @default(false)
  isTrending         Boolean          @default(false)
  isLatest           Boolean          @default(true)
  translationType    String           @default("unofficial") // official | unofficial
  releaseDate        DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  createdAt          DateTime         @default(now())
  seriesRelation     Series?          @relation(fields: [seriesId], references: [id])
  teamRelation       Team?            @relation(fields: [teamId], references: [id])
  endorsementRecords Endorsement[]
  files              ModFile[]
  videoGroups        ModVideoGroup[]
  teamMembers        ModTeamMember[]
  contactLinks       ModContactLink[]
  customTabs         ModCustomTab[]
  commentsRecords    ModComment[]
}

model Endorsement {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  modId     String
  mod       Mod      @relation(fields: [modId], references: [id], onDelete: Cascade)
  value     String   @default("up") // up | down
  createdAt DateTime @default(now())

  @@unique([userId, modId])
}

// ===== ملفات التحميل المتعددة لكل تعريب =====
model ModFile {
  id          String        @id @default(cuid())
  modId       String
  mod         Mod           @relation(fields: [modId], references: [id], onDelete: Cascade)
  title       String
  description String?
  alert       String?
  version     String
  releaseDate DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  fileSize    String
  fileFormat  String
  order       Int           @default(0)
  links       ModFileLink[]
  createdAt   DateTime      @default(now())
}

// ===== روابط كل ملف تحميل =====
model ModFileLink {
  id        String   @id @default(cuid())
  fileId    String
  file      ModFile  @relation(fields: [fileId], references: [id], onDelete: Cascade)
  url       String
  label     String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

// ===== أقسام الفيديوهات (شرح/ترويجي/مراجعة) =====
model ModVideoGroup {
  id        String     @id @default(cuid())
  modId     String
  mod       Mod        @relation(fields: [modId], references: [id], onDelete: Cascade)
  name      String
  order     Int        @default(0)
  videos    ModVideo[]
  createdAt DateTime   @default(now())
}

// ===== الفيديوهات =====
model ModVideo {
  id            String        @id @default(cuid())
  groupId       String
  group         ModVideoGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  title         String
  url           String
  thumbnail     String?
  duration      String?
  description   String?
  views         Int           @default(0)
  likes         Int           @default(0)
  commentsCount Int           @default(0)
  channel       String?
  order         Int           @default(0)
  createdAt     DateTime      @default(now())
}

// ===== أعضاء فريق التعريب =====
model ModTeamMember {
  id           String   @id @default(cuid())
  modId        String
  mod          Mod      @relation(fields: [modId], references: [id], onDelete: Cascade)
  name         String
  avatarUrl    String?
  role         String   @default("مترجم")
  contribution String?
  order        Int      @default(0)
  createdAt    DateTime @default(now())
}

// ===== روابط تواصل الفريق =====
model ModContactLink {
  id        String   @id @default(cuid())
  modId     String
  mod       Mod      @relation(fields: [modId], references: [id], onDelete: Cascade)
  type      String // mail | website | telegram | twitter | youtube | discord
  label     String
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

// ===== التبويبات المخصصة =====
model ModCustomTab {
  id        String   @id @default(cuid())
  modId     String
  mod       Mod      @relation(fields: [modId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  content   String // markdown
  order     Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([modId, slug])
}

// ===== سلاسل التعريبات (مستقلة) =====
model Series {
  id                String   @id @default(cuid())
  slug              String   @unique
  name              String
  description       String   @default("")
  bannerUrl         String   @default("")
  logoUrl           String   @default("")
  color             String   @default("") // accent hex
  isFeatured        Boolean  @default(false)
  isOfficial        Boolean  @default(false)
  order             Int      @default(0)
  modCount          Int      @default(0)
  totalDownloads    Int      @default(0)
  totalEndorsements Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  mods              Mod[]
}

// ===== فرق التعريب =====
model Team {
  id           String            @id @default(cuid())
  slug         String            @unique
  name         String
  description  String            @default("")
  logoUrl      String            @default("")
  bannerUrl    String            @default("")
  websiteUrl   String            @default("")
  discordUrl   String            @default("")
  isOfficial   Boolean           @default(false)
  isFeatured   Boolean           @default(false)
  ownerId      String? // leader
  order        Int               @default(0)
  modCount     Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  mods         Mod[]
  memberships  TeamMembership[]
  contactLinks TeamContactLink[]
}

model TeamMembership {
  id        String   @id @default(cuid())
  teamId    String
  userId    String?
  name      String // اسم العضو (لو بدون حساب)
  avatarUrl String?
  role      String   @default("member") // leader | member | guest | tester
  bio       String?
  joinedAt  DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([teamId, userId])
}

model TeamContactLink {
  id     String @id @default(cuid())
  teamId String
  type   String // mail|website|telegram|twitter|youtube|discord
  label  String
  url    String
  order  Int    @default(0)
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

// ===== إجراءات المستخدمين (Ban/Promote/Demote/etc) =====
model UserAction {
  id         String    @id @default(cuid())
  userId     String // على من اتخذ الإجراء
  action     String // ban | suspend | warn | promote | demote | delete | login | logout | password_change | email_verified
  reason     String?
  byUserId   String? // من قام بالإجراء
  byUsername String?
  expiresAt  DateTime? // للحظر المؤقت
  metadata   String? // JSON
  ipAddress  String?
  createdAt  DateTime  @default(now())
  user       User      @relation("UserActionsTarget", fields: [userId], references: [id], onDelete: Cascade)
  actor      User?     @relation("UserActionsActor", fields: [byUserId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([byUserId])
  @@index([createdAt])
}

model TierRule {
  id                   String   @id @default(cuid())
  tier                 Int      @unique
  name                 String
  nameEn               String
  requiredMods         Int      @default(0)
  requiredDownloads    Int      @default(0)
  requiredRating       Float    @default(0)
  requiredQualityScore Float    @default(0)
  badge                String   @default("")
  badgeColor           String   @default("#6b7280")
  features             String   @default("[]")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model TierHistory {
  id          String    @id @default(cuid())
  userId      String
  fromTier    Int
  toTier      Int
  reason      String    @default("auto") // auto | manual | admin
  triggeredBy String?
  notes       String?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model SpecialRole {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  nameEn      String
  icon        String   @default("Star")
  color       String   @default("#6b7280")
  description String   @default("")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ===== الأخبار =====
model News {
  id         String    @id @default(cuid())
  slug       String    @unique
  title      String
  summary    String    @default("") // للأخبار القصيرة (ticker)
  content    String    @default("") // markdown للتفاصيل (featured)
  imageUrl   String    @default("")
  linkUrl    String? // رابط خارجي اختياري
  category   String    @default("general") // general | update | announcement | event
  type       String    @default("ticker") // ticker | featured
  isSticky   Boolean   @default(false) // تثبيت في التكر
  isAnimated Boolean   @default(true) // حركة تلقائية في التكر
  visible    Boolean   @default(true)
  order      Int       @default(0)
  views      Int       @default(0)
  publishAt  DateTime  @default(now()) // جدولة النشر
  expiresAt  DateTime? // انتهاء العرض
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([type, visible])
  @@index([publishAt])
}

// ===== التعليقات =====
model ModComment {
  id          String       @id @default(cuid())
  modId       String
  mod         Mod          @relation(fields: [modId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestName   String       @default("زائر")
  guestAvatar String?
  parentId    String?
  parent      ModComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     ModComment[] @relation("CommentReplies")
  text        String
  likes       Int          @default(0)
  dislikes    Int          @default(0)
  isPinned    Boolean      @default(false)
  isEdited    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

// ===== سجل النشاطات (Audit Log) =====
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  username  String   @default("system")
  action    String // create | update | delete | login | logout | moderate
  entity    String // mod | game | user | comment | ad | series | setting
  entityId  String?
  details   String? // JSON string with extra info
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([action])
  @@index([entity])
  @@index([userId])
  @@index([createdAt])
}

// ===== إعدادات الموقع =====
model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  group     String   @default("general") // general | appearance | seo | social
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// ===== إعلانات الصفحة الرئيسية =====
// بيدعم: فيديوهات يوتيوب، صور إعلانية، HTML مخصص
// بيتعرض فوق الشريط الجانبي في الصفحة الرئيسية
model HomepageAd {
  id          String   @id @default(cuid())
  type        String   @default("youtube") // youtube | image | html
  url         String // رابط الفيديو (لـ youtube) أو رابط الصورة (لـ image) أو كود HTML (لـ html)
  title       String   @default("")
  description String   @default("")
  link        String? // رابط عند الضغط على الإعلان (لـ image)
  size        String   @default("medium") // small | medium | large | full
  order       Int      @default(0)
  visible     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ===== الإشعارات =====
model Notification {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  type      String
  title     String
  message   String
  data      Json?
  isRead    Boolean   @default(false) @map("is_read")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs NotificationLog[]

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@index([type])
  @@map("notifications")
}

model NotificationPreference {
  id                  String   @id @default(cuid())
  userId              String   @unique @map("user_id")
  emailEnabled        Boolean  @default(true) @map("email_enabled")
  pushEnabled         Boolean  @default(true) @map("push_enabled")
  dailySummary        Boolean  @default(true) @map("daily_summary")
  summaryIntervalDays Int      @default(3) @map("summary_interval_days")
  likeThreshold       Int      @default(25) @map("like_threshold")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model NotificationLog {
  id             String    @id @default(cuid())
  notificationId String    @map("notification_id")
  channel        String
  status         String
  errorMessage   String?   @map("error_message")
  sentAt         DateTime? @map("sent_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@map("notification_logs")
}

// ===== حظر عناوين IP =====
// بيدعم حظر IP مؤقت (expiresAt) أو دائم (null)
// يتم فحصه في middleware عبر Upstash Redis (Edge runtime)
// وفي server-side عبر checkIpBan() مباشرة من DB
model IpBan {
  id               String    @id @default(cuid())
  ipAddress        String    @unique
  reason           String?
  bannedBy         String? // admin userId
  bannedByUsername String?
  expiresAt        DateTime? // null = دائم
  createdAt        DateTime  @default(now())

  @@index([ipAddress])
  @@index([expiresAt])
}
