// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== Report Enums — migrated from String to enum for DB-level safety =====
enum ReportStatus {
  new
  under_review
  confirmed
  rejected
  pending
  resolved
  reopened
}

enum ReportType {
  mod
  comment
  user
  team
}

enum ReportReason {
  spam
  inappropriate
  copyright
  offensive
  false_info
  technical
  other
}

enum ReportPriority {
  low
  medium
  high
  critical
}

enum ReportAction {
  none
  warned
  content_hidden
  content_deleted
  temp_ban
  perm_ban
}

model User {
  id                     String                  @id @default(cuid())
  supabaseId             String?                 @unique // Supabase Auth user ID
  username               String                  @unique
  displayName            String? // اسم العرض المختار من المستخدم
  firstName              String? // الاسم الأول
  lastName               String? // اسم العائلة
  email                  String                  @unique
  password               String? // deprecated — للتوافق مع البيانات القديمة فقط
  avatarUrl              String?
  bannerUrl              String? // صورة الخلفية بمقاس اليوتيوب (2560×1440)
  bio                    String?
  websiteUrl             String? // الموقع الشخصي
  twitterUrl             String? // رابط Twitter/X
  instagramUrl           String? // رابط Instagram
  tiktokUrl              String? // رابط TikTok
  youtubeUrl             String? // رابط YouTube
  githubUrl              String? // رابط GitHub
  discordUrl             String? // رابط Discord
  telegramUrl            String? // رابط Telegram
  accentColor            String?                 @default("#ff8c00") // اللون المميز للملف الشخصي
  profileVisibility      String                  @default("everyone") // everyone | followers | nobody
  hideJoinDate           Boolean                 @default(false) // إخفاء تاريخ الانضمام
  role                   String                  @default("member") // member | creator | publisher | moderator | admin | manager | owner
  bannedUntil            DateTime? // null = غير محظور
  banStatus              String                  @default("active") // active | banned_temp | banned_perm | restricted
  banReason              String? // سبب الحظر الحالي
  bannedBy               String? // id الأدمن الذي أصدر الحظر
  bannedAt               DateTime? // متى تم الحظر
  tokenVersion           Int                     @default(0) // لإبطال الجلسات القديمة عند الحظر/تغيير الدور
  // Security key (alphanumeric) for staff login
  securityKey            String? // Hashed security key
  securityKeyExpiresAt   DateTime? // Expiry set by owner
  securityKeyChangedAt   DateTime? // Last change
  // ===== MFA fields — TOTP/WebAuthn/Recovery =====
  totpSecret             String? // مشفّر base64 — سر TOTP
  totpEnabled            Boolean                 @default(false)
  webauthnCredentials    Json? // مصفوفة مفاتيح الأمان
  mfaRequiredAt          DateTime? // متى فُرضت MFA
  mfaEnabledAt           DateTime? // متى فعّلها المستخدم أول مرة
  recoveryCodes          String? // مشفّر base64 — JSON array
  recoveryCodesUsed      Json? // مصفوفة indices المستعملة
  tier                   Int                     @default(0) // 0=مبتدئ, 1=مترجم, 2=محترف, 3=خبير, 4=مشرف, 5=مدير
  specialRoles           String                  @default("") // CSV: "official_translator,reviewer,team"
  qualityScore           Float                   @default(0) // محسوب تلقائي
  lastTierUpgradeAt      DateTime?
  tierUpgradeCount       Int                     @default(0)
  lastLoginAt            DateTime?
  loginCount             Int                     @default(0)
  emailVerified          Boolean                 @default(false)
  onboardingCompleted    Boolean                 @default(false) // D.6: اكتمال إعداد الحساب (username + password + تأكيد البيانات)
  joinedAt               DateTime                @default(now())
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  mods                   Mod[]                   @relation("AuthoredMods")
  endorsements           Endorsement[]
  comments               ModComment[]
  actionsAsTarget        UserAction[]            @relation("UserActionsTarget")
  actionsAsActor         UserAction[]            @relation("UserActionsActor")
  teamMemberships        TeamMembership[]
  notifications          Notification[]          @relation("UserNotifications")
  actingNotifications    Notification[]          @relation("ActorNotifications")
  notificationPreference NotificationPreference?
  tierHistory            TierHistory[]
  reportsFiled           Report[]                @relation("ReportsFiled")
  reportsTarget          Report[]                @relation("ReportsTarget")
  reportsAssigned        Report[]                @relation("ReportsAssigned")
  trustScore             UserTrustScore?
  reviewedMods           Mod[]                   @relation("ModReviewer")
  workflowChanges        WorkflowEntry[]
  createdVersions        ModVersion[]
  following              Follow[]                @relation("Following")
  followers              Follow[]                @relation("Followers")
  bookmarks              Bookmark[]
  commentLikes           CommentLike[]
  teamFollows            TeamFollow[]
  oauthAccounts          OAuthAccount[]
  reportStatusHistory    ReportStatusHistory[]
  modRatings             ModRating[]
  tickets                Ticket[]
  assignedTickets        Ticket[]                @relation("AssignedTickets")
  ticketMessages         TicketMessage[]
  savedSearches          SavedSearch[]
  modViews               ModView[]
  adClicks               AdClick[]
  newsViews              NewsView[]
  newsClicks             NewsClick[]
  apiKeys                ApiKey[]
  creatorRequests        CreatorRequest[]
  modRequests            ModRequest[]
  acceptedRequests       ModRequest[]            @relation("AcceptedRequests")
  sessions               Session[]

  @@index([role])
  @@index([joinedAt])
  @@index([lastLoginAt])
  @@index([banStatus])
}

// ===== طلبات الترقية لمُعَرِّب =====
model CreatorRequest {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  experience     String?   @db.Text
  preferredGames String?   @db.Text
  portfolioLinks String?   @db.Text
  reason         String?   @db.Text
  status         String    @default("pending") // pending | approved | rejected
  reviewedBy     String?
  reviewedAt     DateTime?
  rejectReason   String?   @db.Text
  twitterUrl     String?
  youtubeUrl     String?
  discordHandle  String?
  websiteUrl     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([userId])
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String // google | discord | telegram
  providerAccountId String // Supabase Auth user ID or Telegram ID
  providerEmail     String? // email from provider (may be null for Telegram)
  providerUsername  String? // username from provider
  avatarUrl         String? // avatar from provider
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// ===== API Keys للوصول البرمجي (MCP Server, Scripts, etc.) =====
model ApiKey {
  id         String    @id @default(cuid())
  key        String    @unique // sk_live_<64 random hex chars>
  name       String // وصفي: "MCP Server - Office PC"
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       String // الدور الممنوح: creator | publisher | moderator | admin | manager | owner
  expiresAt  DateTime? // null = لا ينتهي
  lastUsedAt DateTime?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([isActive])
  @@index([key])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Game {
  id                String     @id @default(cuid())
  slug              String     @unique
  name              String
  tagline           String
  description       String
  bannerUrl         String
  logoUrl           String?
  thumbnailUrl      String
  category          String // RPG | FPS | Strategy | Sandbox | Adventure | Simulation
  platform          String // PC | NS | PS1 | PS2 | PS3 | PS4 | X360
  releaseYear       Int
  modCount          Int        @default(0)
  totalDownloads    Int        @default(0)
  totalEndorsements Int        @default(0)
  featured          Boolean    @default(false)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  mods              Mod[]
  categories        Category[]

  @@index([platform])
  @@index([featured])
  @@index([totalDownloads])
}

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameId    String
  mods      Mod[]
  createdAt DateTime @default(now())

  @@unique([gameId, slug])
}

model Mod {
  id                  String           @id @default(cuid())
  slug                String           @unique
  name                String
  summary             String
  description         String
  changelog           String           @default("") // سجل التغييرات (markdown)
  installGuide        String           @default("") // دليل التركيب (markdown)
  arabicTitle         String           @default("") // الاسم بالعربي
  translationScope    String           @default("") // نطاق التعريب
  compatibility       String           @default("") // التوافق
  authorId            String
  author              User             @relation("AuthoredMods", fields: [authorId], references: [id])
  gameId              String
  game                Game             @relation(fields: [gameId], references: [id], onDelete: Cascade)
  categoryId          String?
  category            Category?        @relation(fields: [categoryId], references: [id])
  thumbnailUrl        String
  imageUrl            String
  galleryUrls         String // comma-separated
  version             String
  fileSize            String
  fileFormat          String // 7z | zip | rar
  downloads           Int              @default(0)
  endorsements        Int              @default(0)
  views               Int              @default(0)
  comments            Int              @default(0)
  rating              Float            @default(0)
  ratingCount         Int              @default(0)
  tags                String // comma-separated
  series              String           @default("") // اسم السلسلة (مثل God of War) — للتوافق العكسي
  seriesId            String? // ربط بالسلسلة الجديدة
  translationTeam     String           @default("") // فريق التعريب أو المترجم المستقل — للتوافق العكسي
  teamId              String? // ربط بالفريق الجديد
  sectionId           String? // ربط بالقسم الرئيسي
  isFeatured          Boolean          @default(false)
  isTrending          Boolean          @default(false)
  isLatest            Boolean          @default(true)
  translationType     String           @default("unofficial") // official | unofficial
  isOriginalWork      Boolean          @default(true)
  originalSource      String?          @db.Text
  originalAuthor      String?
  releaseDate         DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  createdAt           DateTime         @default(now())
  seriesRelation      Series?          @relation(fields: [seriesId], references: [id])
  teamRelation        Team?            @relation(fields: [teamId], references: [id])
  sectionRelation     Section?         @relation(fields: [sectionId], references: [id])
  endorsementRecords  Endorsement[]
  files               ModFile[]
  videoGroups         ModVideoGroup[]
  teamMembers         ModTeamMember[]
  contactLinks        ModContactLink[]
  customTabs          ModCustomTab[]
  commentsRecords     ModComment[]
  reports             Report[]
  bookmarks           Bookmark[]
  downloadClicks      DownloadClick[]
  modViews            ModView[]
  scheduledJobs       ScheduledJob[]
  workflowStatus      String           @default("DRAFT") // DRAFT|IN_REVIEW|APPROVED|PUBLISHED|ARCHIVED|REJECTED
  workflowHistory     WorkflowEntry[]
  submittedAt         DateTime?
  reviewedAt          DateTime?
  publishedAt         DateTime?
  archivedAt          DateTime?
  rejectionReason     String?
  reviewerId          String?
  reviewer            User?            @relation("ModReviewer", fields: [reviewerId], references: [id])
  qualityScore        Float            @default(0)
  qualityRatingsCount Int              @default(0)
  qualityRatingsTotal Float            @default(0)
  qualityRating       Float? // computed average cache
  ratings             ModRating[]
  versionHistory      ModVersion[]
  brokenImages        BrokenImage[]
  isLatestVersion     Boolean          @default(true)
  previousVersionId   String?
  previousVersion     Mod?             @relation("ModVersionChain", fields: [previousVersionId], references: [id])
  nextVersions        Mod[]            @relation("ModVersionChain")
  scheduledAt         DateTime? // وقت النشر المجدول
  scheduledPost       String? // المنشور المولد للنشر
  scheduledSent       Boolean          @default(false)
  scheduledSentAt     DateTime?
  requests            ModRequest[]

  @@index([authorId])
  @@index([gameId])
  @@index([categoryId])
  @@index([seriesId])
  @@index([teamId])
  @@index([sectionId])
  @@index([isFeatured])
  @@index([isTrending])
  @@index([isLatest])
  @@index([releaseDate])
  @@index([updatedAt])
  @@index([translationType])
  @@index([downloads])
  @@index([endorsements])
  @@index([createdAt])
  @@index([workflowStatus])
  @@index([qualityScore])
  @@index([gameId, downloads])
  @@index([gameId, updatedAt])
  @@index([seriesId, downloads])
  @@index([authorId, createdAt])
}

// ===== سجل تغييرات حالة التعريب =====
model WorkflowEntry {
  id            String   @id @default(cuid())
  modId         String
  mod           Mod      @relation(fields: [modId], references: [id], onDelete: Cascade)
  fromStatus    String
  toStatus      String
  changedBy     String
  changedByUser User     @relation(fields: [changedBy], references: [id])
  changedAt     DateTime @default(now())
  reason        String?
  notes         String?

  @@index([modId])
  @@index([changedBy])
  @@index([changedAt])
}

// ===== إصدارات التعريب =====
model ModVersion {
  id            String    @id @default(cuid())
  modId         String
  modVersion    Mod       @relation(fields: [modId], references: [id], onDelete: Cascade)
  version       String
  changelog     String    @default("")
  files         ModFile[]
  createdAt     DateTime  @default(now())
  createdBy     String
  createdByUser User      @relation(fields: [createdBy], references: [id])

  @@index([modId])
  @@index([createdAt])
}

model Endorsement {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  modId     String
  mod       Mod      @relation(fields: [modId], references: [id], onDelete: Cascade)
  value     String   @default("up") // up | down
  createdAt DateTime @default(now())

  @@unique([userId, modId])
  @@index([modId])
}

// ===== ملفات التحميل المتعددة لكل تعريب =====
model ModFile {
  id          String        @id @default(cuid())
  modId       String
  mod         Mod           @relation(fields: [modId], references: [id], onDelete: Cascade)
  versionId   String?
  modVersion  ModVersion?   @relation(fields: [versionId], references: [id], onDelete: SetNull)
  title       String
  description String?
  alert       String?
  version     String
  releaseDate DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  fileSize    String
  fileFormat  String
  order       Int           @default(0)
  links       ModFileLink[]
  createdAt   DateTime      @default(now())

  @@index([modId])
}

// ===== روابط كل ملف تحميل =====
model ModFileLink {
  id        String   @id @default(cuid())
  fileId    String
  file      ModFile  @relation(fields: [fileId], references: [id], onDelete: Cascade)
  url       String
  label     String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([fileId])
}

// ===== أقسام الفيديوهات (شرح/ترويجي/مراجعة) =====
model ModVideoGroup {
  id        String     @id @default(cuid())
  modId     String
  mod       Mod        @relation(fields: [modId], references: [id], onDelete: Cascade)
  name      String
  order     Int        @default(0)
  videos    ModVideo[]
  createdAt DateTime   @default(now())

  @@index([modId])
}

// ===== الفيديوهات =====
model ModVideo {
  id            String        @id @default(cuid())
  groupId       String
  group         ModVideoGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  title         String
  url           String
  thumbnail     String?
  duration      String?
  description   String?
  views         Int           @default(0)
  likes         Int           @default(0)
  commentsCount Int           @default(0)
  channel       String?
  publishedAt   DateTime? // تاريخ نشر الفيديو على يوتيوب
  order         Int           @default(0)
  createdAt     DateTime      @default(now())

  @@index([groupId])
}

// ===== أعضاء فريق التعريب =====
model ModTeamMember {
  id           String   @id @default(cuid())
  modId        String
  mod          Mod      @relation(fields: [modId], references: [id], onDelete: Cascade)
  name         String
  avatarUrl    String?
  role         String   @default("مترجم")
  contribution String?
  order        Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([modId])
}

// ===== روابط تواصل الفريق =====
model ModContactLink {
  id        String   @id @default(cuid())
  modId     String
  mod       Mod      @relation(fields: [modId], references: [id], onDelete: Cascade)
  type      String // mail | website | telegram | twitter | youtube | discord
  label     String
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([modId])
}

// ===== التبويبات المخصصة =====
model ModCustomTab {
  id        String   @id @default(cuid())
  modId     String
  mod       Mod      @relation(fields: [modId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  content   String // markdown
  order     Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([modId, slug])
}

// ===== سلاسل التعريبات (مستقلة) =====
model Series {
  id                String   @id @default(cuid())
  slug              String   @unique
  name              String
  description       String   @default("")
  bannerUrl         String   @default("")
  logoUrl           String   @default("")
  color             String   @default("") // accent hex
  isFeatured        Boolean  @default(false)
  isOfficial        Boolean  @default(false)
  order             Int      @default(0)
  modCount          Int      @default(0)
  totalDownloads    Int      @default(0)
  totalEndorsements Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  mods              Mod[]

  @@index([name])
}

// ===== فرق التعريب =====
model Team {
  id                 String              @id @default(cuid())
  slug               String              @unique
  name               String
  description        String              @default("")
  logoUrl            String              @default("")
  bannerUrl          String              @default("")
  websiteUrl         String              @default("")
  discordUrl         String              @default("")
  telegramUrl        String              @default("")
  isOfficial         Boolean             @default(false)
  isFeatured         Boolean             @default(false)
  ownerId            String? // leader
  order              Int                 @default(0)
  modCount           Int                 @default(0)
  views              Int                 @default(0) // مشاهدات صفحة الفريق (dedup عبر Redis)
  hiddenTabs         String              @default("") // comma-separated tab keys to hide: "stats,mods"
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  mods               Mod[]
  memberships        TeamMembership[]
  contactLinks       TeamContactLink[]
  customTabs         TeamCustomTab[]
  follows            TeamFollow[]
  achievements       TeamAchievement[]
  points             TeamPoints?
  pointsTransactions PointsTransaction[]

  @@index([isFeatured])
  @@index([order])
  @@index([modCount])
  @@index([views])
}

model TeamFollow {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  createdAt DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

model TeamMembership {
  id        String   @id @default(cuid())
  teamId    String
  userId    String?
  name      String // اسم العضو (لو بدون حساب)
  avatarUrl String?
  role      String   @default("member") // leader | member | guest | tester
  bio       String?
  joinedAt  DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([teamId, userId])
  @@index([userId])
}

model TeamContactLink {
  id     String @id @default(cuid())
  teamId String
  type   String // mail|website|telegram|twitter|youtube|discord
  label  String
  url    String
  order  Int    @default(0)
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
}

model TeamCustomTab {
  id      String  @id @default(cuid())
  teamId  String
  title   String
  content String  @default("")
  order   Int     @default(0)
  visible Boolean @default(true)
  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
}

// ===== إجراءات المستخدمين (Ban/Promote/Demote/etc) =====
model UserAction {
  id         String    @id @default(cuid())
  userId     String // على من اتخذ الإجراء
  action     String // ban | suspend | warn | promote | demote | delete | login | logout | password_change | email_verified
  reason     String?
  byUserId   String? // من قام بالإجراء
  byUsername String?
  expiresAt  DateTime? // للحظر المؤقت
  metadata   String? // JSON
  ipAddress  String?
  createdAt  DateTime  @default(now())
  user       User      @relation("UserActionsTarget", fields: [userId], references: [id], onDelete: Cascade)
  actor      User?     @relation("UserActionsActor", fields: [byUserId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([byUserId])
  @@index([createdAt])
  @@index([action])
  @@index([userId, action, createdAt])
}

model TierRule {
  id                   String   @id @default(cuid())
  tier                 Int      @unique
  name                 String
  nameEn               String
  requiredMods         Int      @default(0)
  requiredDownloads    Int      @default(0)
  requiredRating       Float    @default(0)
  requiredQualityScore Float    @default(0)
  badge                String   @default("")
  badgeColor           String   @default("#6b7280")
  features             String   @default("[]")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model TierHistory {
  id          String   @id @default(cuid())
  userId      String
  fromTier    Int
  toTier      Int
  reason      String   @default("auto") // auto | manual | admin
  triggeredBy String?
  notes       String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model SpecialRole {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  nameEn      String
  icon        String   @default("Star")
  color       String   @default("#6b7280")
  description String   @default("")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ===== الأخبار =====
model News {
  id          String      @id @default(cuid())
  slug        String      @unique
  title       String
  summary     String      @default("") // للأخبار القصيرة (ticker)
  content     String      @default("") // markdown للتفاصيل (featured)
  imageUrl    String      @default("")
  linkUrl     String? // رابط خارجي اختياري
  category    String      @default("general") // general | update | announcement | event
  type        String      @default("ticker") // ticker | featured
  isSticky    Boolean     @default(false) // تثبيت في التكر
  isAnimated  Boolean     @default(true) // حركة تلقائية في التكر
  visible     Boolean     @default(true)
  order       Int         @default(0)
  views       Int         @default(0)
  clicksCount Int         @default(0)
  publishAt   DateTime    @default(now()) // جدولة النشر
  expiresAt   DateTime? // انتهاء العرض
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  newsViews   NewsView[]
  newsClicks  NewsClick[]

  @@index([type, visible])
  @@index([publishAt])
  @@index([clicksCount])
}

model NewsView {
