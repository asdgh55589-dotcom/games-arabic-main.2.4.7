  @@index([visible])
  @@index([startDate])
  @@index([endDate])
  @@index([clicksCount])
}

model AdClick {
  id        String     @id @default(cuid())
  adId      String
  ad        HomepageAd @relation(fields: [adId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  ipAddress String?
  userAgent String?
  referrer  String?
  clickedAt DateTime   @default(now())

  @@index([adId])
  @@index([clickedAt])
  @@index([userId])
}

// ===== الإشعارات =====
model Notification {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  actorId   String?   @map("actor_id")
  type      String
  title     String
  message   String
  data      Json?
  isRead    Boolean   @default(false) @map("is_read")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  // Interactive target fields
  targetType     String? @map("target_type")
  targetId       String? @map("target_id")
  targetSlug     String? @map("target_slug")
  targetTitle    String? @map("target_title")
  targetUrl      String? @map("target_url")
  actorUsername  String? @map("actor_username")
  actorAvatarUrl String? @map("actor_avatar_url")

  user  User              @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  actor User?             @relation("ActorNotifications", fields: [actorId], references: [id], onDelete: SetNull)
  logs  NotificationLog[]
  jobs  NotificationJob[]

  @@index([userId])
  @@index([actorId])
  @@index([isRead])
  @@index([createdAt])
  @@index([type])
  @@index([userId, readAt, createdAt])
  @@index([userId, type, createdAt])
  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id                  String   @id @default(cuid())
  userId              String   @unique @map("user_id")
  emailEnabled        Boolean  @default(true) @map("email_enabled")
  pushEnabled         Boolean  @default(true) @map("push_enabled")
  dailySummary        Boolean  @default(true) @map("daily_summary")
  summaryIntervalDays Int      @default(3) @map("summary_interval_days")
  likeThreshold       Int      @default(25) @map("like_threshold")
  quietHoursEnabled   Boolean  @default(false) @map("quiet_hours_enabled")
  quietHoursStart     String?  @map("quiet_hours_start") // "23:00" format
  quietHoursEnd       String?  @map("quiet_hours_end") // "07:00" format
  typePreferences     Json     @default("{}") @map("type_preferences") // Record<NotificationType, TypePreference>
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model NotificationLog {
  id             String    @id @default(cuid())
  notificationId String    @map("notification_id")
  channel        String
  status         String
  errorMessage   String?   @map("error_message")
  sentAt         DateTime? @map("sent_at")
  deliveredAt    DateTime? @map("delivered_at")
  openedAt       DateTime? @map("opened_at")
  clickedAt      DateTime? @map("clicked_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@map("notification_logs")
}

// ===== مهام توصيل الإشعارات =====
model NotificationJob {
  id             String    @id @default(cuid())
  notificationId String    @map("notification_id")
  channel        String // in_app, email, telegram
  status         String    @default("pending") // pending, processing, sent, failed, dead_letter
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5) @map("max_attempts")
  lastError      String?   @map("last_error")
  scheduledFor   DateTime  @default(now()) @map("scheduled_for")
  processedAt    DateTime? @map("processed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([status, scheduledFor])
  @@index([notificationId])
  @@index([channel])
  @@map("notification_jobs")
}

// ===== قوالب الإشعارات =====
model NotificationTemplate {
  id            String   @id @default(cuid())
  type          String // NotificationType enum value
  channel       String // in_app, email, telegram
  titleTemplate String
  bodyTemplate  String
  variables     Json     @default("[]")
  isActive      Boolean  @default(true)
  version       Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([type, channel])
  @@index([isActive])
  @@map("notification_templates")
}

// ===== حظر عناوين IP =====
// بيدعم حظر IP مؤقت (expiresAt) أو دائم (null)
// يتم فحصه في middleware عبر Upstash Redis (Edge runtime)
// وفي server-side عبر checkIpBan() مباشرة من DB
model IpBan {
  id               String    @id @default(cuid())
  ipAddress        String    @unique
  reason           String?
  bannedBy         String? // admin userId
  bannedByUsername String?
  expiresAt        DateTime? // null = دائم
  createdAt        DateTime  @default(now())

  @@index([ipAddress])
  @@index([expiresAt])
}

// ===== نقاط الثقة =====
model UserTrustScore {
  id                       String   @id @default(cuid())
  userId                   String   @unique
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score                    Int      @default(50) // 0-100
  reportAccuracy           Float    @default(0) // confirmed / totalReports
  totalReports             Int      @default(0) // reports filed
  confirmedReports         Int      @default(0) // reports confirmed
  rejectedReports          Int      @default(0) // reports rejected
  reportsReceived          Int      @default(0) // reports received against user
  reportsReceivedConfirmed Int      @default(0) // reports received that were confirmed
  updatedAt                DateTime @updatedAt
  createdAt                DateTime @default(now())

  @@index([userId])
  @@index([score])
}

// ===== البلاغات =====
model Report {
  id         String  @id @default(cuid())
  reporterId String?
  reporter   User?   @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: SetNull)

  targetType      ReportType   // migrated from String
  targetModId     String?
  targetMod       Mod?        @relation(fields: [targetModId], references: [id], onDelete: Cascade)
  targetCommentId String?
  targetComment   ModComment? @relation(fields: [targetCommentId], references: [id], onDelete: Cascade)
  targetUserId    String?
  targetUser      User?       @relation("ReportsTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  reason       ReportReason
  priority     ReportPriority @default(medium)
  description  String?
  evidenceUrls Json? // مصفوفة روابط ["url1","url2"] — يمنع مشاكل الفاصلة ويُستخدم مع تحقق XSS

  status       ReportStatus   @default(new)
  assignedToId String?
  assignedTo   User?     @relation("ReportsAssigned", fields: [assignedToId], references: [id], onDelete: SetNull)
  resolution   String?
  resolvedAt   DateTime?

  actionTaken ReportAction?
  actionAt    DateTime?

  fraudScore         Float @default(0) // 0.0 - 1.0
  repeatOffenseLevel Int   @default(0) // 0-3

  ipAddress String?

  fraudSignals  ReportFraudSignal[]
  statusHistory ReportStatusHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reporterId])
  @@index([targetModId])
  @@index([targetCommentId])
  @@index([targetUserId])
  @@index([status])
  @@index([priority])
  @@index([reason])
  @@index([createdAt])
  @@index([status, priority])
  @@index([reporterId, targetModId, createdAt])
  @@index([reporterId, targetCommentId, createdAt])
  @@index([reporterId, targetUserId, createdAt])
}

// ===== إشارات البلاغات المزيفة =====
model ReportFraudSignal {
  id          String   @id @default(cuid())
  reportId    String
  report      Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  signalType  String // duplicate_pattern | timing_anomaly | target_harassment | low_trust_reporter | same_target_swarm
  score       Float // 0.0 - 1.0
  description String
  createdAt   DateTime @default(now())

  @@index([reportId])
  @@index([signalType])
}

// ===== سجل تغييرات حالة البلاغ =====
model ReportStatusHistory {
  id         String   @id @default(cuid())
  reportId   String
  report     Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  fromStatus ReportStatus?
  toStatus   ReportStatus
  action     ReportAction? // migrated from String
  resolution String?
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([reportId])
  @@index([createdAt])
}

// ===== المفضلة / الحفظ =====
model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  modId     String
  mod       Mod      @relation(fields: [modId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, modId])
  @@index([userId])
  @@index([modId])
}

// ===== إعجابات التعليقات =====
model CommentLike {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  commentId String
  comment   ModComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  value     String     @default("like") // like | dislike
  createdAt DateTime   @default(now())

  @@unique([userId, commentId])
  @@index([userId])
  @@index([commentId])
}

// ===== أقسام المنصات (ديناميكي) =====
model Section {
  id        String   @id @default(cuid())
  slug      String   @unique // URL-friendly: "pc", "ps5", "xbox-360"
  name      String // Arabic display: "PC ARABIC"
  nameEn    String // English: "PC Arabic"
  key       String   @unique // Platform key matching game.platform: "PC", "PS5", "X360"
  icon      String   @default("Monitor") // Lucide icon name
  color     String   @default("#6b7280") // hex color
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mods Mod[]

  @@index([isActive, order])
}

// ===== نقرات التحميل (تتبع روابط الخارجية) =====
model DownloadClick {
  id        String   @id @default(cuid())
  modId     String
  mod       Mod      @relation(fields: [modId], references: [id], onDelete: Cascade)
  fileId    String?
  linkId    String?
  linkUrl   String // الرابط الخارجي الذي تم النقر عليه
  userId    String? // null للزوار المجهولين
  ipAddress String?
  userAgent String?
  referrer  String?
  createdAt DateTime @default(now())

  @@index([modId])
  @@index([createdAt])
  @@index([createdAt, modId])
