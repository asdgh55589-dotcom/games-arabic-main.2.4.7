// ===== التعليقات =====
model ModComment {
  id           String        @id @default(cuid())
  modId        String
  mod          Mod           @relation(fields: [modId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestName    String        @default("زائر")
  guestAvatar  String?
  parentId     String?
  parent       ModComment?   @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies      ModComment[]  @relation("CommentReplies")
  reports      Report[]
  commentLikes CommentLike[]
  text         String
  likes        Int           @default(0)
  dislikes     Int           @default(0)
  isPinned     Boolean       @default(false)
  isEdited     Boolean       @default(false)
  isHidden     Boolean       @default(false)
  depth        Int           @default(0) // عمق التداخل: 0 = جذري، يُحسب عند الإنشاء من الأب
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([modId])
  @@index([userId])
  @@index([parentId])
  @@index([createdAt])
  @@index([modId, createdAt])
  @@index([userId, createdAt])
  @@index([modId, parentId])
  @@index([modId, isHidden, createdAt])
}

// ===== طلبات التعريب =====
model ModRequest {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameName         String
  platform         String
  storeLink        String?   @db.Text // deprecated — استخدم storeLinks
  storeLinks       String?   @db.Text // JSON array: ["https://...","https://..."]
  translationType  String? // deprecated — لم يعد مستخدماً
  notes            String?   @db.Text
  status           String    @default("open") // open | accepted | completed | cancelled
