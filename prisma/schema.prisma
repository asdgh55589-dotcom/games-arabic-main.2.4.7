// ===== مشاهدات التعريبات (صف لكل مشاهدة فريدة بعد dedup عبر Redis) =====
model ModView {
  id        String   @id @default(cuid())
  modId     String
  mod       Mod      @relation(fields: [modId], references: [id], onDelete: Cascade)
  userId    String? // null للزوار المجهولين
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  ipAddress String?
  userAgent String?
  viewedAt  DateTime @default(now())

  @@index([modId])
  @@index([userId])
  @@index([viewedAt])
  @@index([modId, viewedAt])
}

model ScheduledJob {
  id          String    @id @default(cuid())
  type        String // 'telegram_post', 'backup', 'notification', 'cleanup'
  modId       String?
  mod         Mod?      @relation(fields: [modId], references: [id], onDelete: Cascade)
  payload     Json      @default("{}")
  scheduledAt DateTime
  executedAt  DateTime?
  status      String    @default("pending") // pending, running, completed, failed
  error       String?
  retries     Int       @default(0)
  maxRetries  Int       @default(3)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([scheduledAt])
  @@index([type])
}

// ===== تقييمات التعريب =====
model ModRating {
  id        String   @id @default(cuid())
  modId     String
  mod       Mod      @relation(fields: [modId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int // 1-5
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

