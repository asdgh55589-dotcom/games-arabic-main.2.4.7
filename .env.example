# ⚠️ NEVER commit .env to Git! This is a template — copy to .env and fill real values.
# cp .env.example .env
#
# Every variable below is read somewhere in the app. Each entry documents:
#   - what it does
#   - Required / Optional (+ the default that applies when unset)
#   - a placeholder example value (never a real secret)
#   - where it is read ("Used by")
# Search the codebase for new vars: grep -rhoE 'process\.env\.[A-Z_]+' src scripts \
#   instrumentation.ts next.config.ts prisma | sort -u

# ═══ Database ══════════════════════════════════════════════════════════════
# Description: PostgreSQL connection string (Aiven primary / Neon legacy).
#             Pool MUST match Aiven server pool size (5).
# Query-string parameters (not separate env vars):
#   connection_limit:5         → Prisma pool size (one pool per process via src/lib/db.ts singleton)
#   pool_timeout:10            → fail fast after 10s instead of hanging (P2024 on exhaustion)
#   connect_timeout:10         → TCP/TLS connect timeout (Aiven managed-service overhead)
#   statement_timeout:15000    → kill runaway queries after 15s (frees the connection)
#   sslmode=require            → mandatory TLS (enforced by src/lib/db.ts ensureSslmode)
# Required: yes — the app cannot start without it.
# Example: "postgresql://user:password@localhost:5432/games_arabic?sslmode=require&connection_limit=5&pool_timeout=10&connect_timeout=10&statement_timeout=15000"
# Used by: prisma/schema.prisma, src/lib/db.ts, src/lib/backup.ts,
#          src/app/api/cron/weekly-backup/route.ts
DATABASE_URL="postgresql://user:password@localhost:5432/games_arabic?sslmode=require&connection_limit=5&pool_timeout=10&connect_timeout=10&statement_timeout=15000"

# Description: Aiven cutover override — takes priority over DATABASE_URL when non-empty.
#             Populate this on cutover day with the Aiven connection string.
# Required: optional (default: unset → DATABASE_URL is used).
# Example: "postgresql://user:password@host:5432/games_arabic?sslmode=require&connection_limit=5&pool_timeout=10&connect_timeout=10&statement_timeout=15000"
# Used by: src/lib/db.ts, src/app/api/cron/weekly-backup/route.ts
# AIVEN_DATABASE_URL="postgresql://user:password@host:5432/games_arabic?sslmode=require&connection_limit=5&pool_timeout=10&connect_timeout=10&statement_timeout=15000"

# ═══ Auth / Supabase (OAuth: Google, Telegram) ══════════════════════════════
# Description: Supabase project URL used by the browser SDK, server client and
#             session-refresh middleware.
# Required: yes (login breaks without it).
# Example: "https://your-project.supabase.co"
# Used by: src/lib/supabase/client.ts, src/lib/supabase/server.ts,
#          src/lib/supabase/middleware.ts, src/lib/auth.ts
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"

# Description: Supabase anon (public) key — safe for the browser bundle.
# Required: yes.
# Example: "your-anon-key"
# Used by: src/lib/supabase/client.ts, src/lib/supabase/server.ts,
#          src/lib/supabase/middleware.ts
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Description: Supabase service-role key — SERVER-ONLY, bypasses RLS.
# Required: yes for privileged server paths (admin routes, session ledger).
# Example: "your-service-role-key"
# Used by: src/lib/supabase/server.ts, src/lib/auth.ts
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Description: Secret used to sign/verify JWTs (session cookie, MFA and TOTP
#             tokens, admin-role cookie read in Edge middleware).
# Required: yes — generate with: openssl rand -hex 32
# Example: "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
# Used by: src/lib/auth.ts, src/lib/mfa-token.ts, src/lib/totp.ts, src/proxy.ts
JWT_SECRET="your-jwt-secret-here"

# Description: Two-factor enforcement for staff (admin pages + APIs).
#             "1" requires 2FA; needs a rebuild to take effect in production.
# Required: optional (default: unset → enforcement OFF).
# Example: "1"
# Used by: src/proxy.ts
# MFA_ENFORCED="1"

# Description: Owner account username created by the setup route; must match an
#             owner row in the DB (no hardcoded fallback).
# Required: yes for first-run setup.
# Example: "owner"
# Used by: src/app/api/admin/setup/route.ts, src/app/api/auth/login/route.ts
OWNER_USERNAME="owner"

# Description: Owner account email — same setup/login paths as above.
# Required: yes for first-run setup.
# Example: "owner@example.com"
# Used by: src/app/api/admin/setup/route.ts, src/app/api/auth/login/route.ts
OWNER_EMAIL="owner@example.com"

# Description: Owner account password (seeded by the setup route).
# Required: yes for first-run setup. Use a strong generated value.
# Example: "your-secure-password-here"
# Used by: src/app/api/admin/setup/route.ts, src/app/api/auth/login/route.ts
OWNER_PASSWORD="your-secure-password-here"

# Description: Second factor printed at owner setup and required alongside the
#             owner password on login.
# Required: optional (default: fallback "1234567890" — change it before going live).
# Example: "a-long-random-security-key"
# Used by: src/app/api/admin/setup/route.ts, src/app/api/auth/login/route.ts
# OWNER_SECURITY_KEY="a-long-random-security-key"

# ── Telegram (optional — for login + channel posts) ─────────────────────────
# Description: Bot token. When set, Telegram-linked users get ALL account
#             notifications via the bot (users must have started it first).
#             Without it, routing degrades to email-only and Telegram sends
#             resolve fail-open (auth is unaffected).
# Required: optional (default: unset → no Telegram delivery).
# Example: "123456789:AAExampleTokenPlaceholder"
# Used by: src/lib/telegram-webhook-setup.ts, src/lib/telegram-bot.ts,
#          src/lib/telegram-notifications.ts, src/lib/telegram-verify.ts,
#          src/app/api/auth/telegram/webhook/route.ts
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"

# Description: Channel id that receives channel posts from the bot.
# Required: optional (default: unset → no channel posts).
# Example: "-1001234567890"
# Used by: src/lib/telegram-bot.ts
TELEGRAM_CHANNEL_ID="your-telegram-channel-id"

# Description: Server-only bot display name used in message headers. Never
#             exposed to the browser (always undefined in client bundles).
# Required: optional (default: unset).
# Example: "games_arabic_bot"
# Used by: src/lib/telegram-widget.ts (server-side reads)
# TELEGRAM_BOT_NAME="your_bot"

# Description: Public bot username for t.me links and the login button.
# Required: optional (default: unset → login button hidden).
# Example: "your_bot"
# Used by: src/lib/telegram-widget.ts
# NEXT_PUBLIC_TELEGRAM_BOT_USERNAME="your_bot"

# Description: Shared secret Telegram sends in X-Telegram-Bot-Api-Secret-Token;
#             webhook requests without it are rejected (fail-closed).
# Required: optional (default: unset → webhook secret check skipped).
# Example: "random-secret-for-webhook"
# Used by: src/lib/telegram-webhook-setup.ts,
#          src/app/api/auth/telegram/webhook/route.ts, src/app/api/health/detailed/route.ts
# TELEGRAM_WEBHOOK_SECRET="random-secret-for-webhook"

# ═══ Redis (Upstash for rate-limit & ban cache; falls back to memory) ═══════
# Description: Upstash REST endpoint used by the Edge-safe Redis clients
#             (IP ban cache, tokenVersion cache, rate limiting, auth/me cache).
#             In-memory fallback is used when unset.
# Required: optional (default: unset → in-memory cache).
# Example: "https://xxx.upstash.io"
# Used by: src/lib/redis.ts, src/lib/redis-client.ts
UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"

# Description: Upstash REST token paired with UPSTASH_REDIS_REST_URL.
# Required: optional (default: unset → Redis-backed features degrade to memory).
# Example: "AXxxExampleToken"
# Used by: src/lib/redis.ts, src/lib/redis-client.ts
UPSTASH_REDIS_REST_TOKEN="AXxx..."

# ═══ Observability ═════════════════════════════════════════════════════════
# Description: OpenTelemetry OTLP/HTTP logs+metrics endpoint (e.g. OpenObserve).
#             When unset no OTLP exporters are initialized; when set, logs and
#             metrics are exported every 60s (node runtime only, fail-open).
# Required: optional (default: unset → local logging only).
# Example: "http://localhost:5080/api/default"
# Used by: src/lib/observability/otlp.ts, instrumentation.ts
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:5080/api/default"

# Description: Extra OTLP request headers as comma-separated key=value pairs
#             (e.g. "Authorization=Bearer <token>"). Pairs without "=" are ignored.
# Required: optional (default: none → no auth headers sent).
# Example: "Authorization=Bearer example-token"
# Used by: src/lib/observability/otlp.ts
# OTEL_EXPORTER_OTLP_HEADERS="Authorization=Bearer example-token"

# Description: Log level for the pino logger (node runtime). "debug" also enables
#             console debug output in the Edge logger.
# Required: optional (default: "info").
# Example: "debug"
# Used by: src/lib/logger.ts
# LOG_LEVEL="info"

# ── Sentry (optional — error tracking, no-op when empty) ────────────────────
# Description: Browser Sentry DSN. Empty = no client error reporting.
# Required: optional (default: empty → disabled).
# Example: "https://examplePublicKey@o0.ingest.sentry.io/0"
# Used by: src/lib/error-reporting.ts, sentry.client.config.ts
NEXT_PUBLIC_SENTRY_DSN=

# Description: Server Sentry DSN. Empty = no server error reporting.
# Required: optional (default: empty → disabled).
# Example: "https://examplePrivateKey@o0.ingest.sentry.io/0"
# Used by: src/lib/error-reporting.ts, sentry.server.config.ts, sentry.edge.config.ts
SENTRY_DSN=

# Description: Sentry org slug used to build source-map upload URLs in the build.
# Required: optional (default: unset → no source-map upload).
# Example: "my-org-slug"
# Used by: next.config.ts
SENTRY_ORG=

# Description: Sentry project slug used to build source-map upload URLs in the build.
# Required: optional (default: unset → no source-map upload).
# Example: "my-project-slug"
# Used by: next.config.ts
SENTRY_PROJECT=

# ═══ Analytics (consent-gated — no capture until the user grants consent) ════
# Description: Server-side PostHog project API key (posthog-node). Unset = no
#             server-side capture.
# Required: optional (default: unset → server analytics disabled).
# Example: "phc_exampleProjectApiKey"
# Used by: src/lib/analytics/posthog-server.ts
# POSTHOG_API_KEY="phc_exampleProjectApiKey"

# Description: PostHog ingestion host for server-side capture.
# Required: optional (default: "https://app.posthog.com").
# Example: "https://eu.i.posthog.com"
# Used by: src/lib/analytics/posthog-server.ts
# POSTHOG_HOST="https://app.posthog.com"

# Description: Browser PostHog project key (posthog-js). Unset = analytics
#             provider never initializes in the browser.
# Required: optional (default: unset → browser analytics disabled).
# Example: "phc_exampleProjectKey"
# Used by: src/lib/analytics/posthog.ts, src/components/posthog-provider.tsx
# NEXT_PUBLIC_POSTHOG_KEY="phc_exampleProjectKey"

# Description: Browser PostHog ingestion host.
# Required: optional (default: "https://app.posthog.com").
# Example: "https://eu.i.posthog.com"
# Used by: src/lib/analytics/posthog.ts
# NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# Description: Microsoft Clarity project id. The script is injected after first
#             paint and only with stored consent; unset = no Clarity.
# Required: optional (default: unset → Clarity disabled).
# Example: "abcdefghij"
# Used by: src/components/clarity-script.tsx
# NEXT_PUBLIC_CLARITY_ID="abcdefghij"

# ═══ Storage / Image uploads ════════════════════════════════════════════════
# Description: Kill-switch for Cloudinary (user avatars/banners only; mod images
#             go through FreeImage). Fail-closed — flip to "true" only after
#             staging proof. Empty/placeholder values count as unconfigured.
# Required: optional (default: "false").
# Example: "false"
# Used by: src/lib/cloudinary.ts
CLOUDINARY_ENABLED="false"

# Description: Cloudinary cloud name for the account above.
# Required: required when CLOUDINARY_ENABLED="true".
# Example: "your-cloud-name"
# Used by: src/lib/cloudinary.ts
CLOUDINARY_CLOUD_NAME="your-cloud-name"

# Description: Cloudinary API key. SERVER-ONLY.
# Required: required when CLOUDINARY_ENABLED="true".
# Example: "123456789012345"
# Used by: src/lib/cloudinary.ts
CLOUDINARY_API_KEY="your-api-key"

# Description: Cloudinary API secret. SERVER-ONLY — never expose with NEXT_PUBLIC_*.
# Required: required when CLOUDINARY_ENABLED="true".
# Example: "your-api-secret"
# Used by: src/lib/cloudinary.ts
CLOUDINARY_API_SECRET="your-api-secret"

# ── FreeImage (mod images) ──────────────────────────────────────────────────
# Description: Key from https://freeimage.host/page/api?lang=en — SERVER-ONLY,
#             never expose with NEXT_PUBLIC_*. 60MB per image enforced server-side.
# Required: optional (default: unset → mod image uploads unavailable).
# Example: "your-freeimage-key"
# Used by: src/lib/freeimage.ts
# FREEIMAGE_API_KEY="your-freeimage-key"

# ── Internet Archive (mod files, S3 gateway) ───────────────────────────────
# Description: Kill-switch for IA uploads. DISABLED by default — enable ONLY
#             after one real staging upload passes (see
#             src/app/api/storage/ia/README.md: query-presigned sign mode is
#             dead, relay mode is the live path). Keys from
#             https://archive.org/account/s3.php — SERVER-ONLY. See docs/ia-setup.md.
#             Variable names match src/lib/ia.ts getIaConfig() — do not rename.
# Required: optional (default: "false").
# Example: "false"
# Used by: src/lib/ia.ts
IA_ENABLED="false"

# Description: IA S3 access key. SERVER-ONLY.
# Required: required when IA_ENABLED="true".
# Example: "your-ia-access-key"
# Used by: src/lib/ia.ts
IA_ACCESS_KEY="your-ia-access-key"

# Description: IA S3 secret key. SERVER-ONLY.
# Required: required when IA_ENABLED="true".
# Example: "your-ia-secret-key"
# Used by: src/lib/ia.ts
IA_SECRET_KEY="your-ia-secret-key"

# Description: IA S3 identifier (the account's ia###### node identifier).
# Required: required when IA_ENABLED="true".
# Example: "games-arabic-mods"
# Used by: src/lib/ia.ts
IA_IDENTIFIER="games-arabic-mods"

# Description: IA collection the uploads land in. Rarely changes.
# Required: optional (default: "opensource").
# Example: "opensource"
# Used by: src/lib/ia.ts
# IA_COLLECTION="opensource"

# Description: IA S3 endpoint host. Rarely changes.
# Required: optional (default: "https://s3.us.archive.org").
# Example: "https://s3.us.archive.org"
# Used by: src/lib/ia.ts
# IA_S3_ENDPOINT="https://s3.us.archive.org"

# Description: IA S3 region used for SigV4 signing.
# Required: optional (default: "us-east-1").
# Example: "us-east-1"
# Used by: src/lib/ia.ts
# IA_S3_REGION="us-east-1"

# Description: Client-side mirror of IA_ENABLED (controls the IA toggle vs
#             "soon" badge in the upload form). Keep "false" until staging
#             verification passes.
# Required: optional (default: "false").
# Example: "false"
# Used by: src/components/creator/mod-form/files.tsx
NEXT_PUBLIC_IA_ENABLED="false"

# Description: Browser→IA upload mode: "direct" (presigned PUT, full bandwidth)
#             or "relay" (server stream fallback if IA S3 CORS blocks browsers).
#             Public (not secret).
# Required: optional (default: "direct").
# Example: "direct"
# Used by: src/components/creator/mod-form/files.tsx
# NEXT_PUBLIC_IA_UPLOAD_MODE="direct"

# Description: Custom domain attached to the Cloudflare image-proxy worker
#             (workers/image-proxy — see its README for deploy + DNS steps).
#             Unset/empty = app falls back to original image URLs.
# Required: optional (default: unset → original URLs served).
# Example: "img.gamesarabic.com"
# Used by: src/lib/image-worker.ts
# IMG_WORKER_DOMAIN="img.gamesarabic.com"

# ═══ Backups ════════════════════════════════════════════════════════════════
# Description: Local directory for backup dumps and manifests.
# Required: optional (default: <cwd>/backups).
# Example: "/tmp/backups"
# Used by: src/lib/backup.ts, src/app/api/cron/weekly-backup/route.ts
# BACKUP_DIR="/tmp/backups"

# Description: S3-compatible endpoint that receives the weekly dump via a
#             signed curl PUT. When unset the backup stays local only.
# Required: optional (default: unset → no remote upload).
# Example: "https://s3.example.com"
# Used by: src/app/api/cron/weekly-backup/route.ts
# BACKUP_S3_ENDPOINT="https://s3.example.com"

# Description: Target bucket for the weekly backup upload.
# Required: optional (default: "backups" when BACKUP_S3_ENDPOINT is set).
# Example: "games-arabic-backups"
# Used by: src/app/api/cron/weekly-backup/route.ts
# BACKUP_S3_BUCKET="backups"

# Description: Access key for the backup bucket. SERVER-ONLY.
# Required: optional (default: "" → upload attempt fails, local backup still succeeds).
# Example: "EXAMPLEACCESSKEY"
# Used by: src/app/api/cron/weekly-backup/route.ts
# BACKUP_S3_ACCESS_KEY="EXAMPLEACCESSKEY"

# Description: Secret key for the backup bucket. SERVER-ONLY.
# Required: optional (default: "" → upload attempt fails, local backup still succeeds).
# Example: "examplesecretkey"
# Used by: src/app/api/cron/weekly-backup/route.ts
# BACKUP_S3_SECRET_KEY="examplesecretkey"

# ═══ Email (Brevo-first, Emitlo fallback; console in dev when neither) ═══════
# Description: Email provider selection: auto | brevo | emitlo.
#             auto uses Brevo when BREVO_API_KEY is set, else Emitlo when
#             EMITLO_API_KEY is set, else logs to console in dev. The site works
#             without any provider.
# Required: optional (default: "auto").
# Example: "auto"
# Used by: src/lib/email/index.ts
EMAIL_PROVIDER=auto

# ── Brevo (free tier: 300 emails/day) ───────────────────────────────────────
# Description: Brevo API key — https://www.brevo.com (the sender must be
#             verified in Brevo, verified at boot by instrumentation.ts).
# Required: optional (default: unset → Brevo not used).
# Example: "xkeysib-example-key"
# Used by: src/lib/email/brevo.ts, src/lib/email/index.ts
BREVO_API_KEY=

# Description: Verified Brevo sender address (defaults to Brevo's shared
#             noreply@smtp-brevo.com until a sender is verified).
# Required: optional (default: "noreply@smtp-brevo.com").
# Example: "noreply@smtp-brevo.com"
# Used by: src/lib/email/brevo.ts
BREVO_SENDER_EMAIL=noreply@smtp-brevo.com

# Description: Display name used with Brevo sends.
# Required: optional (default: "Games Arabic").
# Example: "Games Arabic"
# Used by: src/lib/email/brevo.ts
BREVO_SENDER_NAME=Games Arabic

# Description: Reply-To address for Brevo sends; omitted from the message when empty.
# Required: optional (default: empty → no Reply-To header).
# Example: "support@example.com"
# Used by: src/lib/email/brevo.ts
BREVO_REPLY_TO=

# ── Emitlo (legacy fallback when Brevo is not configured) ───────────────────
# Description: Emitlo API key used as the fallback email provider.
# Required: optional (default: unset → no Emitlo delivery).
# Example: "em_your_api_key_here"
# Used by: src/lib/email/index.ts, src/lib/email/emitlo.ts
EMITLO_API_KEY="em_your_api_key_here"

# Description: Emitlo REST base URL; the send path is appended to it.
# Required: optional (default: "https://api.emitlo.com").
# Example: "https://api.emitlo.com"
# Used by: src/lib/email/emitlo.ts
# EMITLO_API_URL="https://api.emitlo.com"

# Description: Per-request timeout for Emitlo HTTP calls, in milliseconds.
# Required: optional (default: 10000). Non-numeric or non-positive values fall back.
# Example: "10000"
# Used by: src/lib/email/emitlo.ts
# EMITLO_TIMEOUT_MS="10000"

# ── Shared sender ───────────────────────────────────────────────────────────
# Description: Default From address/name for outbound email (used when the
#             provider-specific sender is not configured).
# Required: optional (default: empty → falls back to provider defaults).
# Example: "noreply@games-arabic.com"
# Used by: src/lib/email/from.ts
EMAIL_FROM="noreply@games-arabic.com"

# ═══ Security ═══════════════════════════════════════════════════════════════
# Description: Comma-separated list of allowed origins for cross-origin API
#             access. Same-origin always works; only listed origins get
#             Access-Control-* headers.
# Required: optional (default: empty → no cross-origin access).
# Example: "https://app.example.com,https://mobile.example.com"
# Used by: src/proxy.ts
ALLOWED_ORIGINS=

# Description: Cookie domain attribute for auth cookies; needed for cookies
#             shared across subdomains. Unset = host-only cookies.
# Required: optional (default: unset → host-only cookies).
# Example: ".yourdomain.com"
# Used by: src/lib/auth.ts
# COOKIE_DOMAIN=".yourdomain.com"

# Description: Shared secret protecting /api/cron/* endpoints (e.g. image health
#             check, weekly backup) when called by an external cron service.
#             Generate with: openssl rand -hex 16
# Required: optional (default: unset → cron routes reject unauthenticated calls).
# Example: "0123456789abcdef0123456789abcdef"
# Used by: src/lib/cron-auth.ts
# CRON_SECRET="your-random-secret-here"

# ═══ App / Runtime ══════════════════════════════════════════════════════════
# Description: Public canonical site URL — SEO metadata, sitemap/robots,
#             OpenGraph, and the canonical link inside notification emails.
# Required: yes (must be the real public origin in production).
# Example: "http://localhost:3000"
# Used by: src/app/sitemap.ts, src/app/robots.ts, src/app/mod/[slug]/page.tsx,
#          src/app/games/[slug]/page.tsx, src/app/series/[slug]/page.tsx,
#          src/app/teams/[slug]/page.tsx, src/app/profile/[user]/page.tsx,
#          src/lib/team-invites.ts, src/app/api/auth/callback/route.ts,
#          src/lib/email/templates.ts, src/lib/email-service.ts (via notifications)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Description: Absolute app URL used to build action links in emails and
#             Telegram messages and to register the Telegram webhook.
#             Alias of NEXT_PUBLIC_SITE_URL — either one works; this one wins
#             when both are set.
# Required: optional (default: NEXT_PUBLIC_SITE_URL, else empty).
# Example: "http://localhost:3000"
# Used by: src/lib/notifications/email-service.ts, src/lib/notification-router.ts,
#          src/lib/telegram-webhook-setup.ts, src/lib/email/templates.ts
# NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Framework-provided (documented for completeness — do NOT set these) ──────
# NODE_ENV — marks development vs production (in-memory rate-limit cache, pretty
#   pino transport, dev-only fallbacks such as logging email to the console).
#   Framework-provided: "production" in builds, "development" for `next dev`.
#   Used by: src/lib/db.ts, src/lib/redis.ts, src/lib/auth.ts, src/lib/logger.ts,
#            src/lib/email/index.ts, src/lib/error-reporting.ts,
#            src/app/api/auth/*, src/components/error-boundary.tsx
# NEXT_RUNTIME — which runtime the current bundle runs in; used to skip
#   Edge-incompatible providers (Prisma, OTLP, Brevo boot verification).
#   Framework-provided: "nodejs" for server routes, "edge" for middleware.
#   Used by: src/lib/logger.ts, instrumentation.ts
# PORT / HOSTNAME — bind address for the standalone server; set by the Dockerfile.
#   Defaults: 3000 / 0.0.0.0. Used by: Dockerfile (runtime, not app code).

# Description: ANALYZE=true makes next build run the bundle-analyzer (bundle
#             diet tooling).
# Required: optional (default: false).
# Example: "true"
# Used by: next.config.ts
# ANALYZE="false"



# ═══ AI / Search ════════════════════════════════════════════════════════════
# Description: Google AI Studio key used to structure pasted mod texts
#             (server-only; no client exposure).
# Required: optional (default: unset → /api/ai/structure unavailable).
# Example: "AIzaExampleKeyForPlaceholderOnly"
# Used by: src/app/api/ai/structure/route.ts
GEMINI_API_KEY=

# ── Meilisearch (Prisma fallback when empty) ────────────────────────────────
# Description: Meilisearch host URL. When unset the search API falls back to
#             Prisma queries.
# Required: optional (default: unset → Prisma fallback).
# Example: "http://localhost:7700"
# Used by: src/lib/meilisearch/client.ts
# MEILISEARCH_HOST="http://localhost:7700"

# Description: Meilisearch master key. SERVER-ONLY.
# Required: optional (default: unset → unauthenticated Meilisearch).
# Example: "your-master-key"
# Used by: src/lib/meilisearch/client.ts
# MEILISEARCH_MASTER_KEY="your-master-key"

# ═══ Testing / Tooling ══════════════════════════════════════════════════════
# Description: Base URL targeted by scripts/load-test.ts (autocannon smoke or
#             --full pressure run). Overridden by the --url= flag.
# Required: optional (default: "http://localhost:3000").
# Example: "http://localhost:3000"
# Used by: scripts/load-test.ts
# LOAD_TEST_URL="http://localhost:3000"

# ── YouTube (yt-dlp for video metadata) ─────────────────────────────────────
# Description: Absolute path to the yt-dlp binary used to fetch video metadata.
#             Falls back to `yt-dlp` on PATH when unset.
# Required: optional (default: "yt-dlp" on PATH).
# Example: "/usr/local/bin/yt-dlp"
# Used by: src/app/api/youtube/metadata/route.ts
# YT_DLP_PATH="/usr/local/bin/yt-dlp"