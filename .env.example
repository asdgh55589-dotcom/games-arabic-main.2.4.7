# ⚠️ NEVER commit .env to Git! This is a template — copy to .env and fill real values.
# cp .env.example .env

# ── Database ──────────────────────────────────────────────────────────────
# PostgreSQL (Neon / Aiven) — keep connection_limit low for serverless
# Note: DIRECT_URL is no longer used (was for unpooled migrations). Use DATABASE_URL only.
DATABASE_URL="postgresql://user:password@localhost:5432/games_arabic?connection_limit=5&pool_timeout=10&sslmode=require"
# Aiven cutover: set AIVEN_DATABASE_URL to override DATABASE_URL (takes priority when non-empty).
# On cutover day, populate this with the Aiven connection string; app prefers it over DATABASE_URL.
# AIVEN_DATABASE_URL="postgresql://user:password@host:5432/games_arabic?sslmode=require&connection_limit=5&pool_timeout=10&connect_timeout=10"

# ── Supabase Auth (OAuth: Google, Telegram) ─────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ── Auth ─────────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -hex 32
JWT_SECRET="your-jwt-secret-here"

# Two-factor enforcement for staff (admin pages + APIs). Default OFF (unset).
# Set to "1" to require 2FA — needs rebuild to take effect in production.
# MFA_ENFORCED="1"

# Owner account (required — no hardcoded fallback; must match an owner in DB)
OWNER_USERNAME="owner"
OWNER_EMAIL="owner@example.com"
OWNER_PASSWORD="your-secure-password-here"

# ── Telegram Bot (optional — for login + channel posts) ───────────────────
# Telegram-first notifications: when set, Telegram-linked users get ALL
# account notifications via the bot (bot must be able to message them —
# users start the bot once). Without it, notification routing degrades to
# email-only and every Telegram send resolves fail-open (auth unaffected).
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_CHANNEL_ID="your-telegram-channel-id"
# Optional helpers (leave empty if not used):
# TELEGRAM_BOT_NAME="your_bot"
# NEXT_PUBLIC_TELEGRAM_BOT_USERNAME="your_bot"  # public, for t.me links + login button
# TELEGRAM_WEBHOOK_SECRET="random-secret-for-webhook"

# ── Site ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# NEXT_PUBLIC_APP_URL is an alias of NEXT_PUBLIC_SITE_URL (either works)
# COOKIE_DOMAIN is optional (e.g., ".yourdomain.com" for cross-subdomain cookies)

# ── Email (optional — Brevo-first, Emitlo fallback) ──────────────────────
# Email provider selection: auto (default) | brevo | emitlo.
# auto uses Brevo when BREVO_API_KEY is set, else Emitlo when EMITLO_API_KEY
# is set, else logs to console in dev. Site works without any provider.
EMAIL_PROVIDER=auto

# Brevo Configuration (free tier: 300 emails/day)
# Get a free key at https://www.brevo.com (sender must be verified in Brevo)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@smtp-brevo.com
BREVO_SENDER_NAME=Games Arabic
BREVO_REPLY_TO=

# Legacy Emitlo (optional fallback when Brevo is not configured)
EMITLO_API_KEY="em_your_api_key_here"
# EMITLO_API_URL defaults to https://api.emitlo.com when unset
# EMITLO_API_URL="https://api.emitlo.com"
EMAIL_FROM="noreply@games-arabic.com"

# ── Redis (Upstash for rate-limit & ban cache; falls back to memory) ──────
# Get free DB at https://upstash.com (REST URL + token from DB details page)
UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="AXxx..."

# ── Cloudinary (EXCLUSIVELY user avatars/banners; mods→FreeImage) ──
# Get free account at https://cloudinary.com (25GB free)
# Fail-closed: CLOUDINARY_ENABLED defaults to "false" — owner flips to "true"
# only after staging proof. Empty/placeholder values = unconfigured.
CLOUDINARY_ENABLED="false"
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ── Phase 2 uploads: FreeImage (mod images) ──────────────────────────────
# Key from https://freeimage.host/page/api?lang=en — SERVER-ONLY, never
# expose with NEXT_PUBLIC_*. 60MB per image enforced server-side (P2 unified cap).
# FREEIMAGE_API_KEY="your-freeimage-key"

# ── Phase 2 uploads: Internet Archive (mod files, S3 gateway) ────────────
# DISABLED by default — enable ONLY after one real staging upload passes
# (see src/app/api/storage/ia/README.md: query-presigned sign mode is dead,
# relay mode is the live path). Keys from https://archive.org/account/s3.php
# — SERVER-ONLY, never expose with NEXT_PUBLIC_*. See docs/ia-setup.md.
# NOTE: variable names below match src/lib/ia.ts getIaConfig() — do not rename.
IA_ENABLED="false"
IA_ACCESS_KEY="your-ia-access-key"
IA_SECRET_KEY="your-ia-secret-key"
IA_IDENTIFIER="games-arabic-mods"
# IA_COLLECTION defaults to "opensource"; endpoint/region rarely change:
# IA_COLLECTION="opensource"
# IA_S3_ENDPOINT="https://s3.us.archive.org"
# IA_S3_REGION="us-east-1"
# Client-side mirror of the flag (controls the IA toggle vs "soon" badge).
# Keep "false" until staging verification passes (see note above).
NEXT_PUBLIC_IA_ENABLED="false"

# ── Phase 2 uploads: Cloudflare image-proxy worker ───────────────────────
# Custom domain attached to workers/image-proxy (see its README for
# deploy + DNS steps). Unset/empty = app falls back to original URLs.
# IMG_WORKER_DOMAIN="img.gamesarabic.com"
# Browser→IA mode: direct (presigned PUT, full bandwidth) or relay
# (server stream fallback if IA S3 CORS blocks browsers). Public (not secret).
# NEXT_PUBLIC_IA_UPLOAD_MODE="direct"

# ── Cron (optional — for image health check) ───────────────────────────────
# CRON_SECRET is used to protect /api/cron/image-health (external cron service)
# Generate with: openssl rand -hex 16
# CRON_SECRET="your-random-secret-here"

# ── YouTube (optional — yt-dlp for video metadata) ───────────────────────
# YT_DLP_PATH="/usr/local/bin/yt-dlp"

# ── Backups (optional) ───────────────────────────────────────────────────
# BACKUP_DIR="/tmp/backups"

# ── Sentry (optional — error tracking, no-op when empty) ──
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=


# ── Meilisearch (optional — search index; Prisma fallback when empty) ──
# MEILISEARCH_HOST="http://localhost:7700"
# MEILISEARCH_MASTER_KEY="your-master-key"
